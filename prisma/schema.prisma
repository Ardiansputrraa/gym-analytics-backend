datasource db {
  provider = "postgresql"
  schemas  = ["identity", "profile", "exercise", "workout", "body", "nutrition", "calorie", "analytics"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

// ============================================================
// IDENTITY SCHEMA
// ============================================================

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@schema("identity")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  name            String    @db.VarChar(255)
  phone           String?   @unique @db.VarChar(20)
  isAdmin         Boolean   @default(false) @map("is_admin")
  isActive        Boolean   @default(true) @map("is_active")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  otpTokens      OtpToken[]
  profile        UserProfile?
  calorieTargets DailyCalorieTarget[]
  exercises      Exercise[]

  @@map("users")
  @@schema("identity")
}

model OtpToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  type      OtpType
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  attempts  Int       @default(0) @db.SmallInt
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type], name: "idx_otp_user_type")
  @@index([expiresAt], name: "idx_otp_expires_at")
  @@map("otp_tokens")
  @@schema("identity")
}

// ============================================================
// PROFILE SCHEMA
// ============================================================

enum Gender {
  MALE
  FEMALE

  @@schema("profile")
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE

  @@schema("profile")
}

enum FitnessGoal {
  FAT_LOSS
  MAINTENANCE
  MUSCLE_GAIN

  @@schema("profile")
}

enum DietPace {
  RELAXED
  STANDARD
  EXTREME

  @@schema("profile")
}

model UserProfile {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String        @unique @map("user_id") @db.Uuid
  age                 Int           @db.SmallInt
  gender              Gender
  heightCm            Decimal       @map("height_cm") @db.Decimal(5, 2)
  weightKg            Decimal       @map("weight_kg") @db.Decimal(6, 3)
  activityLevel       ActivityLevel @map("activity_level")
  fitnessGoal         FitnessGoal   @map("fitness_goal")
  dietPace            DietPace      @default(STANDARD) @map("diet_pace")
  checkInIntervalDays Int           @default(30) @map("check_in_interval_days") @db.SmallInt

  // Struk Body Composition Analyzer Detailed Fields (Optional)
  skeletalMuscleKg    Decimal?      @map("skeletal_muscle_kg") @db.Decimal(6, 2)
  bodyFatPct          Decimal?      @map("body_fat_pct") @db.Decimal(5, 2)
  bodyFatKg           Decimal?      @map("body_fat_kg") @db.Decimal(6, 2)
  fatFreeMassKg       Decimal?      @map("fat_free_mass_kg") @db.Decimal(6, 2)
  waterContentKg      Decimal?      @map("water_content_kg") @db.Decimal(6, 2)
  proteinKg           Decimal?      @map("protein_kg") @db.Decimal(6, 2)
  mineralKg           Decimal?      @map("mineral_kg") @db.Decimal(6, 2)

  isDeleted           Boolean       @default(false) @map("is_deleted")
  deletedAt           DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
  @@schema("profile")
}

// ============================================================
// CALORIE SCHEMA
// ============================================================

model DailyCalorieTarget {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  date           DateTime    @db.Date
  bmr            Decimal     @db.Decimal(8, 2)
  activityFactor Decimal     @map("activity_factor") @db.Decimal(4, 3)
  tdee           Decimal     @db.Decimal(8, 2)
  fitnessGoal    FitnessGoal @default(MAINTENANCE) @map("fitness_goal")
  dietPace       DietPace    @default(STANDARD) @map("diet_pace")
  goalAdjustment Int         @default(0) @map("goal_adjustment")
  targetCalories Int         @map("target_calories")
  proteinGrams   Int?        @map("protein_grams")
  carbsGrams     Int?        @map("carbs_grams")
  fatGrams       Int?        @map("fat_grams")
  isDeleted      Boolean     @default(false) @map("is_deleted")
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date], name: "uq_dct_user_date")
  @@index([userId, date], name: "idx_dct_user_date")
  @@map("daily_calorie_targets")
  @@schema("calorie")
}

// ============================================================
// EXERCISE SCHEMA
// ============================================================

enum ExerciseType {
  STRENGTH
  CARDIO_TREADMILL
  CARDIO_GENERIC
  BODYWEIGHT

  @@schema("exercise")
}

enum EquipmentCategory {
  BARBELL
  DUMBBELL
  CABLE
  MACHINE
  SMITH
  BODYWEIGHT
  TREADMILL
  STATIONARY_BIKE
  STAIR_MASTER
  ROWING_MACHINE
  ELLIPTICAL
  OTHER

  @@schema("exercise")
}

model MuscleGroup {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String     @unique @db.VarChar(100)
  displayName String     @map("display_name") @db.VarChar(100)
  description String?    @db.Text
  orderIndex  Int        @default(0) @map("order_index")
  isDeleted   Boolean    @default(false) @map("is_deleted")
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(6)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  exercises Exercise[]

  @@map("muscle_groups")
  @@schema("exercise")
}

model Exercise {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String?           @map("user_id") @db.Uuid
  name                String            @db.VarChar(255)
  description         String?           @db.Text
  equipment           EquipmentCategory @default(BARBELL)
  exerciseType        ExerciseType      @default(STRENGTH) @map("exercise_type")
  primaryMuscleGroupId String           @map("primary_muscle_group_id") @db.Uuid
  isCustom            Boolean           @default(false) @map("is_custom")
  isActive            Boolean           @default(true) @map("is_active")
  isDeleted           Boolean           @default(false) @map("is_deleted")
  deletedAt           DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryMuscleGroup MuscleGroup       @relation(fields: [primaryMuscleGroupId], references: [id])

  @@index([userId, isDeleted], name: "idx_exercises_user_deleted")
  @@index([primaryMuscleGroupId, equipment, isDeleted], name: "idx_exercises_lookup")
  @@map("exercises")
  @@schema("exercise")
}

